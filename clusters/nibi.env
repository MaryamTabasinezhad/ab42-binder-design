# Nibi (Alliance Canada, University of Waterloo) — Worker
CLUSTER_NAME="nibi"
CLUSTER_ROLE="worker"

# Paths
PROJECT_ROOT="/home/ghaedi/projects/def-ghaedi/ghaedi/protein"
SCRATCH_ROOT="/scratch/ghaedi/protein"
ALZHEIMER_ROOT="${PROJECT_ROOT}/alzheimer"
BINDCRAFT_ROOT="${ALZHEIMER_ROOT}/bindcraft"
BINDCRAFT_REPO="${BINDCRAFT_ROOT}/repo"
DESIGNS_DIR="${BINDCRAFT_ROOT}/designs"
STRUCTURES_DIR="${ALZHEIMER_ROOT}/structures"

# SLURM
SLURM_ACCOUNT="def-ghaedi"
GPU_TYPE="h100"
GPU_GRES="gpu:h100:1"
MAX_WALLTIME="6-23:00:00"
PARALLEL_WALLTIME="05:59:00"
MAIN_MEM="64G"
PARALLEL_MEM="48G"

# Conda environments
CONDA_ENV_BINDCRAFT="BindCraft"
CONDA_ENV_COLABFOLD="colabfold"
CONDA_ENV_MPNN="mpnn_cu12.4"

# Globus
GLOBUS_ENDPOINT="07baf15f-d7fd-4b6a-bf8a-5b5ef2e229d3"
GLOBUS_ENDPOINT_TYPE="institutional"
GLOBUS_BASE_PATH="/home/ghaedi/projects/def-ghaedi/ghaedi/protein"
