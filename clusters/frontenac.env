# Frontenac (CAC, Queen's University) — Coordinator
CLUSTER_NAME="frontenac"
CLUSTER_ROLE="coordinator"

# Paths
PROJECT_ROOT="/global/project/hpcg6049/protein"
SCRATCH_ROOT="/global/scratch/hpc6049/protein"
ALZHEIMER_ROOT="${PROJECT_ROOT}/alzheimer"
BINDCRAFT_ROOT="${ALZHEIMER_ROOT}/bindcraft"
BINDCRAFT_REPO="${BINDCRAFT_ROOT}/repo"
DESIGNS_DIR="${BINDCRAFT_ROOT}/designs"
STRUCTURES_DIR="${ALZHEIMER_ROOT}/structures"

# SLURM
SLURM_ACCOUNT="def-hpcg6049_gpu"
SLURM_ACCOUNT_CPU="def-hpcg6049_cpu"
GPU_TYPE="a100"
GPU_GRES="gpu:a100:1"
MAX_WALLTIME="13-23:00:00"
PARALLEL_WALLTIME="05:59:00"
MAIN_MEM="64G"
PARALLEL_MEM="48G"

# Conda environments
CONDA_ENV_BINDCRAFT="BindCraft"
CONDA_ENV_COLABFOLD="colabfold"
CONDA_ENV_MPNN="mpnn"
CONDA_ENV_RFD="rfd_clean"

# Containers
CONTAINER_DIR="${PROJECT_ROOT}/container"
RFDIFFUSION_SIF="${SCRATCH_ROOT}/container/rfdiffusion.sif"
COLABFOLD_SIF="${CONTAINER_DIR}/colabfold_1.6.1-cuda12.sif"
COLABFOLD_CACHE="${CONTAINER_DIR}/colabfold_cache"
APPTAINER_MODULE="apptainer/1.4.5"

# Globus
GLOBUS_ENDPOINT="79136050-41db-11f1-8063-0afffe4617ab"
GLOBUS_ENDPOINT_TYPE="personal"
GLOBUS_BASE_PATH="/global/project/hpcg6049/protein"
