; Energy minimization — steepest descent
; First-pass: relax bad clashes from the appended N-terminus.
integrator          = steep
nsteps              = 5000
emtol               = 1000.0
emstep              = 0.01

nstlist             = 10
cutoff-scheme       = Verlet
ns_type             = grid
coulombtype         = PME
rcoulomb            = 1.0
rvdw                = 1.0

pbc                 = xyz
constraints         = none
