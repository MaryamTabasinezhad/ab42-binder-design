; Energy minimization — conjugate gradient
; Second-pass after steepest descent has removed the worst clashes.
integrator          = cg
nsteps              = 5000
emtol               = 100.0
emstep              = 0.01
nstcgsteep          = 1000

nstlist             = 10
cutoff-scheme       = Verlet
ns_type             = grid
coulombtype         = PME
rcoulomb            = 1.0
rvdw                = 1.0

pbc                 = xyz
constraints         = none
